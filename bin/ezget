#!/bin/bash

function usage()
{
cat << EOF
This script copies files from the Android device to a files hierarchy on
the devel PC. EzApp must be running on the Android device, and have 
Devel_Mode enabled.
  
This script must be run from a directory in a files hierarchy. The files
hierarchy is not required to be in the ezApp repo.

Options:
  -h             : display help and exit
  -d <dev>       : <dev_name|dev_ipaddr>[:port]
  -p <password>  : ezApp devel mode password
Environment variables EZAPP_DEVICE and EZAPP_PASSWD may be used instead
of the -d and -p options.

Usage examples:

# Copy all files from Android ezApp Morse dir to devel PC.
cd files/apps/Morse
ezget

# Copy all files from Android files hierarchy to devel PC.
# This will take some time if there are large files.
cd files
ezget

# Copy a specific file from the Android files hierarchy to the devel PC.
cd files
ezget apps/Log/logs/261013_171312.log
EOF
} 

# #############  MAIN  ################

# get device and developer password from optional env vars
dev=$EZAPP_DEVICE
password=$EZAPP_PASSWD

# process options 
# -h             : display usage
# -d <dev>       : dev name (such as from /etc/hosts), or dev ipaddr
# -p <password>  : devel password
while true; do
    if [ "$1" = "-h" ]; then
        usage
        exit 0
    elif [ "$1" = "-d" ]; then
        dev=$2
        shift 2
    elif [ "$1" = "-p" ]; then
        password=$2
        shift 2
    elif [[ "$1" == "-"* ]]; then
        echo "ERROR: invalid option $1"
        exit 1
    else
        break
    fi
done

# verify dev and password have been provided,
# either from env vars or the -d and -p options
if [ "$dev" = "" -o "$password" = "" ]; then
    echo "ERROR: device and password are required"
    exit 1
fi

# determine the top of the files directory tree,
# this works if CWD is one of the following directories, for example:
# - /path_to_files/files
# - /path_to_files/files/apps
# - /path_to_files/files/apps/Camera
# - /path_to_files/files/apps/Camera/photos
if [ $(basename "$PWD") = files ]; then
    files_dir=$PWD
elif [ $(basename "$(dirname "$PWD")") = files ]; then
    files_dir=$(dirname $PWD)
elif [ $(basename "$(dirname "$(dirname "$PWD")")") = files ]; then
    files_dir=$(dirname $PWD)
    files_dir=$(dirname $files_dir)
elif [ $(basename "$(dirname "$(dirname "$(dirname "$PWD")")")") = files ]; then
    files_dir=$(dirname $PWD)
    files_dir=$(dirname $files_dir)
    files_dir=$(dirname $files_dir)
else
    echo "ERROR: $PWD must be in files directory tree"
    exit 1
fi

# init list of files/directories that will be transferred from Android to devel PC
if [ "$*" != "" ]; then
    for fn in $*; do
        real=$(realpath -s -m --relative-base $files_dir "$fn")
        android_files="$android_files $real"
    done
else
    real=$(realpath -s --relative-base $files_dir $PWD)
    android_files=$real
fi

# print message detailing what is to be copied from Android
echo "INFO: Get the following files from Android:"
for fn in $android_files; do
    echo "INFO: - $fn"
done
echo

# prompt to continue
read -p "Continue (y/n)? " yn
if [ "$yn" != y ]; then
    echo "ABORT"
    exit 1
fi
echo

# create tar file on Android
ezsh -d $dev -p $password -q "tar -cf ../cache/ezget.tar $android_files 2>&1"
if [ $? -ne 0 ]; then 
    echo "ERROR: failed to create ../cache/ezget.tar on Android device"
    exit 1
fi

# copy ../cache/ezget.tar from Android device to /tmp
ezsh -d $dev -p $password -q "get ../cache/ezget.tar /tmp"
if [ $? -ne 0 ]; then 
    echo "ERROR: failed to copy ../cache/ezget.tar from Android device to devel PC"
    exit 1
fi

# extract /tmp/ezget.tar on devel PC
cd $files_dir
echo "INFO: extracting /tmp/ezget.tar file on devel PC $files_dir"
tar -xvf /tmp/ezget.tar --exclude "log_fifo" 2>&1
if [ $? -ne 0 ]; then 
    echo "ERROR: failed to extract /tmp/ezget.tar on devel PC"
    exit 1
fi

# cleanup
rm -f /tmp/ezget.tar
ezsh -d $dev -p $password -q "rm -f ../cache/ezget.tar"

# done okay
exit 0
