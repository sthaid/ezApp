#!/bin/bash

function usage()
{
cat << EOF
This script restores Android ezApp data files that had previously been
saved by the ezbackup script.

This script may be run from any directory within the ezApp repo.

Options:
  -h             : display help and exit
  -d <dev>       : <dev_name|dev_ipaddr>[:port]
  -p <password>  : ezApp devel mode password
Environment variables EZAPP_DEVICE and EZAPP_PASSWD may be used instead
of the -d and -p options.
EOF
}

# #############  MAIN  ################

# get device and developer password from optional env vars
dev=$EZAPP_DEVICE
password=$EZAPP_PASSWD

# process options 
# -h             : display usage
# -d <dev>       : dev name (such as from /etc/hosts), or dev ipaddr
# -p <password>  : devel password
while true; do
    if [ "$1" = "-h" ]; then
        usage
        exit 0
    elif [ "$1" = "-d" ]; then
        dev=$2
        shift 2
    elif [ "$1" = "-p" ]; then
        password=$2
        shift 2
    elif [[ "$1" == "-"* ]]; then
        echo "ERROR: invalid option $1"
        exit 1
    else
        break
    fi
done

# verify dev and password exist
if [ -z "$dev" -o -z "$password" ]; then
    echo "ERROR: dev and password required"
    exit 1
fi

# cd ezApp/bin/backups
top=$(git rev-parse --show-toplevel)
if [ $? -ne 0 ]; then
    echo "ERROR: failed to get top repo directory"
    exit 1
fi
cd $top/bin/backups
if [ $? -ne 0 ]; then
    echo "ERROR: failed cd to $top/bin/backups"
    exit 1
fi

# if no arg provided then list available backup files
if [ $# -eq 0 ]; then
    echo "Available backup files:"
    ls -l
    exit 1
fi

# if num args > 1 then error
if [ $# -gt 1 ]; then
    echo "ERROR: just one arg expected"
    exit 1
fi

# get backup_filename from arg1, and verify it exists
backup_filename=$1
if [ ! -f $backup_filename ]; then
    echo "ERROR: $backup_filename does not exist"
    exit 1
fi

# define EZSH
EZSH="ezsh -d $dev -p $password"

# verify Android device is quiesced, there should be no apps/svcs running
# when the Android ezApp data files are being restored 
echo "checking that android device is quiesced"
$EZSH quiesced
if [ $? -ne 0 ]; then
    echo "ERROR: android device is either not responding, or"
    echo "ERROR: ezApp has an app or svcs running"
    exit 1
fi
echo

# copy the backup tar file to the Android device
echo "copying $backup_filename to android device"
$EZSH "put $backup_filename"
if [ $? -ne 0 ]; then
    echo "ERROR: ezsh put failed"
    exit 1
fi
echo

# extract the backup tar file on the Android device
echo "extracting $backup_filename on android device"
$EZSH "tar -xvf $backup_filename"
if [ $? -ne 0 ]; then
    echo "ERROR: ezsh tar -xvf failed"
    exit 1
fi
echo

# remove the backup tar file from the Android device
echo "removing $backup_filename from android device"
$EZSH "rm $backup_filename"
if [ $? -ne 0 ]; then
    echo "ERROR: ezsh rm failed"
    exit 1
fi
echo
