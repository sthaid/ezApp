#!/bin/bash

function linux_build()
{
    CFLAGS="-Wall -Werror -Wno-unused-result -Wno-format-truncation -Wno-unused-but-set-variable"
    CFLAGS="$CFLAGS -fcommon -g"
    CFLAGS="$CFLAGS -Dmain=MAIN -DLINUX"
    LIB_PATH=$(pwd)/../linux/local/lib
    gcc -o /tmp/$APP_NAME $CFLAGS ../bin/src/eztest_linux_wrapper.c $SRCS \
        -I . -I ../linux/local/include \
        -L $LIB_PATH -lezApp_lib -lmp3lame -lcJSON -llodepng -lkissfft-float -lSDL3 -lSDL3_mixer -lSDL3_ttf -ljpeg -lm \
        -Wl,-rpath,$LIB_PATH
    if [ $? -ne 0 ]; then
        echo "ABORT: failed to build /tmp/$APP_NAME"
        exit 1
    fi
}

function usage()
{
echo -e "\
\n\
This script builds and runs the app or svc in the current directory.\n\
\n\
Usage: eztest <cmd>\n\
- run_on_picoc, runp: build on linux, then run using picoc\n\
- run_on_linux, runl: build and run on linux
- build: test build on linux\n\
\n\
Default cmd is run_on_picoc.\n\
"
}

# ######## SCRIPT STARTS HERE ########

# set full path to the ezlogfilter program
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
ezlogfilter="$SCRIPT_DIR/src/ezlogfilter"

# set APP_NAME variable
APP_NAME=$(basename $(pwd))

# print action
CMD=$1
if [ "$CMD" = build ]; then
    echo "Performing linux build of $APP_NAME ..."
elif [ "$CMD" = run_on_picoc -o "$CMD" = runp -o "$CMD" = "" ]; then
    echo "Performing picoc run of $APP_NAME ..."
    CMD=run_on_picoc
elif [ "$CMD" = run_on_linux -o "$CMD" = runl ]; then
    echo "Performing linux run of $APP_NAME ..."
    CMD=run_on_linux
else
    usage
    exit 1
fi
echo

# verify parent directory is 'apps' or 'svcs'
PARENT_DIR=$(basename $(dirname $PWD))
if [ "$PARENT_DIR" != apps -a "$PARENT_DIR" != svcs ]; then
    echo "ERROR: parent_dir must be apps or svcs"
    exit 1
fi

# build and run is performed from the 'files' dir
cd ../..

# get list of src files, relative to the 'files' dir
SRCS=$(echo $PARENT_DIR/$APP_NAME/*.c)
if [ "$PARENT_DIR" = apps ]; then
  SRCS="$SRCS lib/lib.c"
fi

# debug prints
#echo "PARENT_DIR  = $PARENT_DIR"
#echo "APP_NAME    = $APP_NAME"
#echo "SRCS        = $SRCS"

# ensure the key libraries are built;
# note that this does not build all libraries,
# libraries which would need to be manually built (if changed) are:
# cJSON kissfft lodepng libmp3lame SDL SDL_mixer SDL_ttf
make -C ../linux ezApp_lib picoc
if [ $? -ne 0 ]; then
    echo ABORT
    exit 1
fi

# build app/svc on linux
linux_build

# if run_on_linux requested then run the linux build 
if [ "$CMD" = run_on_linux ]; then
    # the { } syntax preserves the exception message generated by the shell if crash occurs
    { /tmp/$APP_NAME $PARENT_DIR/$APP_NAME; } |& $ezlogfilter
    exit 0
fi

# if run_on_picoc requested then run using picoc
if [ "$CMD" = run_on_picoc ]; then
    LIB_PATH=$(pwd)/../linux/local/lib
    gcc -o /tmp/picoc -D UNIX_HOST -O2 -g -Wall -Werror ../src/picoc/picoc.c ../src/picoc/picoc_ezApp.c \
        -L $LIB_PATH -lpicoc -lezApp_lib -lmp3lame -lcJSON -llodepng -lkissfft-float -lSDL3 -lSDL3_mixer -lSDL3_ttf -ljpeg -lm \
        -Wl,-rpath,$LIB_PATH
    if [ $? -ne 0 ]; then
        echo "ABORT: failed to build /tmp/picoc"
        exit 1
    fi

    cp ../bin/src/eztest_picoc_wrapper.c /tmp
    sed -i -e "s=PROGNAME=$APP_NAME=" -e "s=DATA_DIR=$PARENT_DIR/$APP_NAME=" /tmp/eztest_picoc_wrapper.c
    # the { } syntax preserves the exception message generated by the shell if crash occurs
    { /tmp/picoc -S $SRCS /tmp/eztest_picoc_wrapper.c; } |& $ezlogfilter
    if [ $? -ne 0 ]; then
        echo ABORT
        exit 1
    fi
    exit 0
fi

