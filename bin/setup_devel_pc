#!/bin/bash

# To get this script (replace 'main' with branch_name)
# - wget https://raw.githubusercontent.com/sthaid/ezApp/refs/heads/main/bin/setup_devel_pc  

# Before running this script:
# - user must be member of sudo group
# - config values must be set, refer to function config_init
# - path_to_rsa_key_dir must be set to directory containing id_rsa and id_rsa.pub;
#     this can be ~/.ssh if the rsa key is already present in that directory
# - path_to_android_tools must be path to android sdk tools zip file;
#     which can be downloaded from
#     https://developer.android.com/studio#command-line-tools-only
# - if git_clone_using_ssh is true then a github account is required, 
#     and must be configured with the user's id_rsa.pub
#   ezapp_device should be set to the IP address of your Android device
#   ezapp_passwd should be set to the ezApp Devel_Password
#   accept_sdk_license should be set true to automatically accept the sdk license;
#     set this true only if you understand and accept the Android SDK license conditions
#   run_build should be set true if you want this script to also build ezApp

# This script performs the following steps:
# - display and validate the config settings
# - prompts to continue
# - copies your provided rsa key to ~/.ssh
# - install and configure git
# - git clone ezApp
# - install required linux packages
# - install android sdk, this creates ~/android/sdk
# - creates ~/.vimrc
# - create ~/.bashrc_ezapp, and adds a call to this from ~/.bashrc

# This script has been tested on
# - Ubuntu 26.04 LTS
# - Windows 11 WSL distro Ubuntu-26.04

# To execute this script:
# - modify config values for your needs
# - chmod 755 setup_devel_pc
# - ./setup_devel_pc

# ######## FUNCTION ########

SSH_REPO_URL=git@github.com:sthaid/ezApp.git
HTTPS_REPO_URL=https://github.com/sthaid/ezApp.git

function config_init()
{
    # Note: avoid using spaces in the paths, spaces have not been tested.

    if [ "$running_on" = ubuntu_wsl ]; then
        path_to_rsa_key_dir=/mnt/c/Users/STEVEN~1/.ssh
        path_to_android_tools=/mnt/c/Users/STEVEN~1/Downloads/commandlinetools-linux-15859902_latest.zip
    elif [ "$running_on" = ubuntu_linux ]; then
        path_to_rsa_key_dir=~/.ssh
        path_to_android_tools=/home/haid/Downloads/commandlinetools-linux-15859902_latest.zip
    else
        echo "BUG: unexpected value for running_on=$running_on"
        exit 1
    fi

    your_name="Steven Haid"
    your_email=stevenhaid@gmail.com
    branch_name=wsl_devel   # xxx temp
    git_clone_using_ssh=true
    create_vimrc=true
    ezapp_device=192.168.1.243
    ezapp_passwd=secret
    accept_sdk_licenses=true
    run_build=true;

    echo "Config:"
    echo "- path_to_rsa_key_dir    = $path_to_rsa_key_dir"
    echo "- path_to_android_tools  = $path_to_android_tools"
    echo "- your_name              = $your_name"
    echo "- your_email             = $your_email"
    echo "- branch_name            = $branch_name"
    echo "- git_clone_using_ssh    = $git_clone_using_ssh"
    echo "- create_vimrc           = $create_vimrc"
    echo "- ezapp_device           = $ezapp_device"
    echo "- ezapp_passwd           = $ezapp_passwd"
    echo "- accept_sdk_licenses    = $accept_sdk_licenses"
    echo "- run_build              = $run_build"
    echo

    # verify user is  member of sudo group
    if ! groups |  grep -q "sudo"; then
        echo "ERROR user is not member of sudo group"
        exit 1
    fi

    # verify path_to_rsa_key_dir exists and contains file id_rsa
    if [ ! -d "$path_to_rsa_key_dir" -o ! -f "$path_to_rsa_key_dir"/id_rsa ]; then
        echo "ERROR file $path_to_rsa_key_dir/id_rsa does not exist"
        exit 1
    fi

    # verify path_to_android_tools exists
    if [ ! -f "$path_to_android_tools" ]; then
        echo "ERROR $path_to_android_tools does not exist"
        exit 1
    fi

    # verify branch_name is provided
    if [ -z "$branch_name" ]; then
        echo "ERROR branch_name is required"
        exit 1
    fi

    # verify git repo and branch exists
    if ! git ls-remote --exit-code "$HTTPS_REPO_URL" &> /dev/null; then
        echo "ERROR repo $HTTPS_REPO_URL not accessible"
        exit 1
    fi
    if ! git ls-remote --exit-code --heads "$HTTPS_REPO_URL" "refs/heads/${branch_name}" &> /dev/null; then
        echo "ERROR branch $branch_name is not accessible"
        exit 1
    fi

    # warn that .vimrc will be replaced
    if [ "$create_vimrc" = true -a -f ~/.vimrc ]; then
        echo "Warning: existing .vimrc will be replaced"
        echo
    fi

    # prompt to continue
    read -p "Continue (y/n)? " yn
    if [ "$yn" != y ]; then
        exit 1
    fi
    echo
}

function determine_running_on()
{
    if echo "$WSL_DISTRO_NAME" | grep -qi "ubuntu"; then
        running_on=ubuntu_wsl
    elif [ -f /etc/os-release ]; then
        . /etc/os-release
        if [ "$ID" = "ubuntu" ]; then
            running_on=ubuntu_linux
        fi
    fi
    if [ "$running_on" = "" ]; then
        echo "ERROR: not running ubuntu_linux or ubuntu_wsl"
        exit 1
    fi
}

function get_rsa_key()
{
    # if path_to_rsa_key_dir = ~/.ssh then nothing to do, just return
    tmp1=$(readlink -f ~/.ssh)
    tmp2=$(readlink -f "$path_to_rsa_key_dir")
    if [ "$tmp1" = " $tmp2" ]; then 
        return
    fi

    mkdir -p ~/.ssh

    cp $path_to_rsa_key_dir/id_rsa $path_to_rsa_key_dir/id_rsa.pub ~/.ssh
    if [ $? -ne 0 ]; then
        echo "ERROR: failed to copy rsa key files from $path_to_rsa_key_dir"
        exit 1
    fi

    chmod 600 ~/.ssh/id_rsa
    chmod 644 ~/.ssh/id_rsa.pub
}

function install_linux_packages()
{
    sudo apt update

    # devel tools
    sudo apt install -y git build-essential pkg-config cmake openjdk-17-jdk-headless \
                        cscope universal-ctags vim unzip x11-apps meld

    # wayland
    sudo apt install -y libwayland-dev     # display protocol, replaces X11
    sudo apt install -y wayland-protocols  # adds extra features to wayland display system

    # graphics library
    sudo apt install -y libgl1-mesa-dev libegl1-mesa-dev libgles2-mesa-dev libgles2

    # audio
    sudo apt install -y libasound2-dev     # ALSA audio, connect to computer's sound hardware
    sudo apt install -y libpulse-dev       # client for PulseAudio sound server, required by WSL

    # misc
    sudo apt install -y libssl-dev         # secure socket layer
    sudo apt install -y libreadline-dev    # readline
    sudo apt install -y libfreetype-dev    # render text fonts into bitmap
    sudo apt install -y libxkbcommon-dev   # translate raw keypresses to characters
    sudo apt install -y libdecor-0-dev     # draws window title bar and border
    sudo apt install -y xfonts-base xfonts-100dpi xfonts-75dpi xfonts-scalable
                                           # fix for 'Warning: Missing charsets in String to FontSet conversion'
}

function create_vimrc_func()
{
cat << 'EOF' > ~/.vimrc
" tabs
set expandtab
set tabstop=8
set softtabstop=4
set shiftwidth=4
" enable copy and paste out of vim
set mouse=r
" disable autoinent
set nocindent
set nosmartindent
set noautoindent
set indentexpr=
filetype indent off
filetype plugin indent off
" highlight search
set hlsearch
" disable show next match while entering a search
set noincsearch
" jump to last line position when reopening a file
if has("autocmd")
  au BufReadPost * if line("'\"") > 1 && line("'\"") <= line("$") | exe "normal! g'\"" | endif
endif
" search current dir and parents for tags file
set tags=./tags;
EOF
}

function create_bashrc_ezApp()
{
# create ~/.bashrc_ezApp
cat << 'EOF' > ~/.bashrc_ezApp

# -----------------------
# ---- .bashrc_ezApp ----
# -----------------------

# command aliases
alias ls='ls -l --color=always --group-directories-first --human-readable'
alias gca='git commit --all -m cont; git push'
alias bashrc='source ~/.bashrc'

# change dir aliases
alias ez='cd ~/ezApp'

alias ez_src='cd ~/ezApp/src'
alias ez_android='cd ~/ezApp/android'
alias ez_linux='cd ~/ezApp/linux'
alias ez_files='cd ~/ezApp/files'
alias ez_bin='cd ~/ezApp/bin'
alias ez_doc='cd ~/ezApp/doc'

alias ez_main='cd ~/ezApp/src/ezApp'
alias ez_lib='cd ~/ezApp/src/ezApp_lib'
alias ez_picoc='cd ~/ezApp/src/picoc'

alias ez_apps='cd ~/ezApp/files/apps'
alias ez_svcs='cd ~/ezApp/files/svcs'

# env vars
export EDITOR=vim
export GIT_EXTERNAL_DIFF=$HOME/ezApp/bin/git_external_diff
export ANDROID_HOME=$HOME/android/sdk
export ANDROID_NDK_ROOT=$ANDROID_HOME/ndk/27.0.12077973
export ADB_MDNS=0   # disable MDNS device discovery

# PATH env var
if [ "$PATH_INITIALIZED" = "" ]; then
    export PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools
    export PATH=$PATH:~/ezApp/bin:.
    export PATH_INITIALIZED=true
fi

# set bash prompt to include git branch name
parse_git_branch() {
     git branch --show-current 2> /dev/null | sed 's/\(.*\)/ (\1)/'
}
export PS1="\u@\h \[\033[32m\]\w\[\033[33m\]\$(parse_git_branch)\[\033[00m\] \$ "

EOF

# additions to ~/.bashrc_ezApp when running on wsl
if [ "$running_on" = ubuntu_wsl ]; then
    cat << 'EOF' >> ~/.bashrc_ezApp
# WSL: force the Linux graphics stack (Mesa) to route GPU commands through
# Windows Direct3D 12 (D3D12) instead of looking for native Linux hardware drivers.
export GALLIUM_DRIVER="d3d12"
export MESA_LOADER_DRIVER_OVERRIDE="d3d12"

EOF
fi

# additions to ~/.bashrc_ezApp, allowing variable substiturion
cat << EOF >> ~/.bashrc_ezApp
export EZAPP_DEVICE=$ezapp_device
export EZAPP_PASSWD=$ezapp_passwd

EOF

# add call .bashrc_ezApp from .bashrc
cat << 'EOF' >> ~/.bashrc

# call .bashrc_ezApp
source ~/.bashrc_ezApp

EOF

# execute .bashrc_ezApp
source ~/.bashrc_ezApp
}

# ######## MAIN ########

# change to home dir
cd ~

# determine running_on, either ubuntu_linux or ubuntu_wsl
determine_running_on
echo "Running on $running_on"
echo

# initialize and verify config params
config_init

# get rsa key
if [ -n "$path_to_rsa_key_dir" ]; then
    get_rsa_key
    echo "Obtained copy of id_rsa and id_rsa.pub from $path_to_rsa_key_dir"
    echo
fi

# install and configure git
sudo apt install git
git config --global user.email "$your_email"
git config --global user.name "$your_name"
echo "Installed and configured git"
echo

# git clone ezApp, and set branch
if [ "$git_clone_using_ssh" = true ]; then
    git clone -b $branch_name $SSH_REPO_URL
else
    git clone -b $branch_name $HTTPS_REPO_URL
fi
echo "Cloned ezApp and set branch to $branch_name"
echo

# install linux packages
install_linux_packages
echo "Installed Linux packages"
echo

# install android sdk
ezApp/bin/install_android_sdk $path_to_android_tools $accept_sdk_licenses
echo "Installed android/sdk from $path_to_android_tools"
echo

# create vimrc
if [ "$create_vimrc" = true ]; then
    create_vimrc_func
    echo "Created ~/.vimrc"
    echo
fi

# create ~/.bashrc_ezApp, and update ~/.bashrc to call it
create_bashrc_ezApp
echo "Created ~/.bashrc_ezApp, and updated .bashrc to call it"
echo

# build ezApp and ezApp/android
if [ "$run_build" = true ]; then
    source ./bashrc_ezApp
    make -C ~/ezApp
    echo "Completed make -C ~/ezApp"
    echo
    make -C ~/ezApp/android
    echo "Completed make -C ~/ezApp/android"
    echo
fi

# provide final instructions
if [ "$running_on" = ubuntu_wsl ]; then
    echo "User must restart wsl, from Windows cmd prompt:"
    echo "> wsl --shutdown"
    echo "> wsl ~"
    echo
elif [ "$running_on" = ubuntu_linux ]; then
    echo "User must reload bash configuration"
    echo "$ source ~/.bashrc"
else
    echo "BUG: unexpected value for running_on=$running_on"
    exit 1
fi
echo

# success
exit 0
